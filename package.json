{
  "name": "logseq-formater",
  "version": "1.0.0",
  "description": "Automatically converts Logseq syntax to Markdown when opening MD files.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run lint && node esbuild.config.mjs production",
    "deploy": "npm run build && node deploy.mjs",
    "release": "node release.mjs",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "keywords": [
    "logseq",
    "converter",
    "markdown"
  ],
  "author": "lizhifeng",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.5",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "eslint": "^9.39.4",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
